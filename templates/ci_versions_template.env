# Implements: .claude/skills/apex-ci-setup/SKILL.md (pinned CI tool versions)
# =============================================================================
# CI tool versions — the one place to change them. Copy to ci/versions.env.
#
# Read by .github/workflows/ci.yml and build-ci-image.yml (KEY=value lines;
# no quotes, no spaces around "="). Upgrading = a PR that edits this file;
# that PR's own CI run proves the new version works.
# =============================================================================

# -----------------------------------------------------------------------------
# Baked into the CI image. Changing any of these means: run
# build-ci-image.yml on the PR's branch first, with a NEW CI_IMAGE_TAG, so
# older branches keep pulling the image they were tested with.
# -----------------------------------------------------------------------------
ORACLE_DB_IMAGE=container-registry.oracle.com/database/free:23.26.1.0
APEX_VERSION=26.1
APEX_URL=https://download.oracle.com/otn_software/apex/apex_26.1.zip
UTPLSQL_TAG=v.3.2.3
# Where CI pulls the image from. build-ci-image.yml can only push under this
# repo's own owner (ghcr.io/<owner>/...); point this there if you build your own.
CI_IMAGE_REPO=ghcr.io/aftorres02/oracle-apex-utplsql
CI_IMAGE_TAG=26.1-utplsql3.2.3

# -----------------------------------------------------------------------------
# Installed on every run — a change takes effect on the next run.
# Find versions at https://www.oracle.com/database/sqldeveloper/technologies/sqlcl/download/
# -----------------------------------------------------------------------------
SQLCL_URL=https://download.oracle.com/otn_software/java/sqldeveloper/sqlcl-26.3.1.301.1413.zip
